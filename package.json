{
  "name": "gdrivebot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create drive-bot-db",
    "db:init:local": "wrangler d1 execute drive-bot-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute drive-bot-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.45.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  }
}
