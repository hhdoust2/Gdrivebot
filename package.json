{
  "name": "telegram-drive-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create drive-bot-db",
    "db:init:local": "wrangler d1 execute drive-bot-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute drive-bot-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
